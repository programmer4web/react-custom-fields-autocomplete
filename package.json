{
  "name": "react-custom-fields-autocomplete",
  "version": "1.0.2",
  "description": "A reusable React component for managing custom fields with autocomplete functionality",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && rollup -c rollup.config.mjs && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "dev": "rollup -c rollup.config.mjs -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "autocomplete",
    "custom-fields",
    "material-ui",
    "mui",
    "form"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "@mui/material": ">=5.0.0",
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^18.0.0",
    "rollup": "^4.67.4",
    "rollup-plugin-peer-deps-external": "^2.2.4"
  },
  "resolutions": {
    "browserslist": "^4.29.5",
    "picomatch": "^4.0.7"
  },
  "author": "Andrei-Constantin Alexandru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programmer4web/react-custom-fields-autocomplete.git"
  },
  "bugs": {
    "url": "https://github.com/programmer4web/react-custom-fields-autocomplete/issues"
  },
  "homepage": "https://github.com/programmer4web/react-custom-fields-autocomplete#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {}
}
